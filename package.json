{
  "name": "frontpaneldesigner",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Parametric front panel designer with CNC V-bit engraving output (SVG)",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "cam-smoke": "vite-node scripts/make-cam-smoke.ts",
    "build:hershey": "vite-node scripts/build-hershey.ts"
  },
  "dependencies": {
    "idb": "^8.0.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "hersheytext": "^2.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.9",
    "vitest": "^3.2.4"
  }
}
